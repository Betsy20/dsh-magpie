{
  "name": "dsh-magpie",
  "version": "0.1.0",
  "description": "把 magpie 原版 Web UI 嵌进 DSH 侧边栏；缺 magpie 时自动下载，缺网关时自动启动",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "magpie",
    "llm",
    "openai-compatible"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Betsy",
  "homepage": "https://github.com/Betsy20/dsh-magpie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Betsy20/dsh-magpie.git"
  },
  "bugs": {
    "url": "https://github.com/Betsy20/dsh-magpie/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "node scripts/build.mjs",
    "magpie:download": "node scripts/fetch-magpie.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^22.20.0",
    "esbuild": "^0.24.0",
    "typescript": "~5.9.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
